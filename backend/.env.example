# ==============================================================================
# Live Call Editor - Backend Environment Configuration Template
# Copy this file to `.env` before running locally. NEVER commit `.env`!
# ==============================================================================

# Optional: Self-hosted third-party music gateway base URL (e.g. NeteaseCloudMusicApi)
MUSIC_API_BASE_URL=http://127.0.0.1:3000

# Optional: Cookie / Token forwarded ONLY to your self-hosted MUSIC_API_BASE_URL
NETEASE_COOKIE=
MUSIC_API_TOKEN=

# Optional: Endpoint paths on your self-hosted gateway
MUSIC_SEARCH_PATH=/search
MUSIC_LYRIC_PATH=/lyric
MUSIC_URL_PATH=/song/url

# Open lyrics provider (LRCLIB)
LRCLIB_BASE_URL=https://lrclib.net

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Upstream HTTP request timeout (seconds)
HTTP_TIMEOUT_SECONDS=10
